# Copy to .env (never commit .env). Values below are PLACEHOLDERS only.
APP_SECRET=replace-with-a-long-random-string
DATABASE_URL=            # optional: postgresql://USER:PASSWORD@HOST:5432/DBNAME (Supabase). Empty = local SQLite file
DB_PATH=ruralcare.db
CORS_ORIGINS=http://localhost:5173
# First administrator (created at start-up if missing). Password min 10 characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
PLATFORM_TZ_OFFSET_SECONDS=19800
# Optional AI (assistant in the Guide + wording layer for the symptom checker). Emergency rules never depend on it.
# Gemini: create a key in Google AI Studio and set it ONLY as an environment variable on the server (Render).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_PROVIDER=gemini  (only needed if both Gemini and Anthropic keys are set)
# Anthropic (alternative):
ANTHROPIC_API_KEY=
AI_MODEL=
AI_API_URL=
# Frontend (Vercel): VITE_API_URL=https://your-backend.onrender.com
